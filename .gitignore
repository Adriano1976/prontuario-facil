# Combined .gitignore file (Base + Antigravity/VS Code optimized)

# --- Base Rules (Logs & Runtime) ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*
pids
*.pid
*.seed
*.pid.lock

# --- Dependency Directories ---
node_modules/
jspm_packages/
.pnpm-store
.npm
bower_components

# --- Build & Output ---
dist
dist-ssr
.output
.next
out
.nuxt
.svelte-kit
.vitepress
.docusaurus
.serverless
.fusebox
build/Release
lib-cov
coverage
*.lcov
.nyc_output
.grunt
.temp
.cache
.parcel-cache
.vite
vite.config.*.ts
vite.config.*.js
vite.config.*.cjs
vite.config.*.mjs
vite.config.*.timestamp-*

# --- Environment & Config ---
.env
.env.test
.env.*
*.local
.lock-wscript
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.yarn-integrity
.tern-port
.dynamodb
.firebase

# --- Tool Specific (Antigravity/Base44) ---
base44/.app.jsonc

# --- Editor & IDE (VS Code & others) ---
.vscode/*
!.vscode/extensions.json
.vscode-test
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Cache/Temporary (Compilation) ---
typings/
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# --- Yarn PnP ---
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions

# Reversa
.reversa/config.user.toml
