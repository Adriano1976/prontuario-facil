{
  "name": "Template",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do template"
    },
    "type": {
      "type": "string",
      "enum": [
        "receita_simples",
        "receita_controlada",
        "atestado",
        "solicitacao_exame",
        "encaminhamento",
        "declaracao",
        "anamnese"
      ],
      "description": "Tipo do template"
    },
    "content": {
      "type": "string",
      "description": "Conte\u00fado do template com vari\u00e1veis"
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Vari\u00e1veis dispon\u00edveis"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Template padr\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "type",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
