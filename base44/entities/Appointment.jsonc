{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "description": "ID do paciente"
    },
    "doctor_id": {
      "type": "string",
      "description": "ID do m\u00e9dico"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do agendamento"
    },
    "duration": {
      "type": "number",
      "default": 30,
      "description": "Dura\u00e7\u00e3o em minutos"
    },
    "type": {
      "type": "string",
      "enum": [
        "primeira_consulta",
        "retorno",
        "exame",
        "procedimento"
      ],
      "default": "primeira_consulta"
    },
    "status": {
      "type": "string",
      "enum": [
        "agendado",
        "confirmado",
        "em_atendimento",
        "concluido",
        "cancelado",
        "faltou"
      ],
      "default": "agendado"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es sobre o agendamento"
    },
    "reminder_sent": {
      "type": "boolean",
      "default": false,
      "description": "Se o lembrete foi enviado"
    },
    "reminder_sent_date": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o lembrete foi enviado"
    },
    "consultation_id": {
      "type": "string",
      "description": "ID da consulta realizada (quando conclu\u00eddo)"
    }
  },
  "required": [
    "patient_id",
    "doctor_id",
    "date"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
