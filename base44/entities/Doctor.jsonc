{
  "name": "Doctor",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Nome completo do m\u00e9dico"
    },
    "specialty": {
      "type": "string",
      "description": "Especialidade m\u00e9dica"
    },
    "crm": {
      "type": "string",
      "description": "N\u00famero do CRM"
    },
    "email": {
      "type": "string",
      "description": "Email do m\u00e9dico"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "photo_url": {
      "type": "string",
      "description": "Foto do m\u00e9dico"
    },
    "working_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Dias da semana que trabalha (0=domingo, 1=segunda, etc)"
    },
    "working_hours": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "description": "Hor\u00e1rio de trabalho"
    },
    "appointment_duration": {
      "type": "number",
      "default": 30,
      "description": "Dura\u00e7\u00e3o padr\u00e3o da consulta em minutos"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "full_name",
    "specialty",
    "crm"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
